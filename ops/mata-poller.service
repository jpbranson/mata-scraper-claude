# Installed by ops/setup.sh (which also adds User=). Paths assume /opt/mata-scraper-claude.
[Unit]
Description=MATA bus position poller
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/mata-scraper-claude
ExecStart=/opt/mata-scraper-claude/.venv/bin/python cadavl_to_gtfs_rt.py
Restart=always
RestartSec=10
Environment=TZ=America/Chicago

[Install]
WantedBy=multi-user.target
